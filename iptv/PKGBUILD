# Edit on github: https://github.com/LizardByte/Sunshine/blob/master/packaging/linux/Arch/PKGBUILD
# Reference: https://wiki.archlinux.org/title/PKGBUILD

VERSION=${VERSION:-1.0}
arch=('any')
pkgname='iptv'
pkgdesc="iptv, watch TV from across the world on your console"
pkgrel=3
pkgver=$VERSION
echo ${pkgver}

package() {
    echo $PWD       # possibly srcpkg
    ls -latr ../
    # --- binaries
    cp -R ../release/* $pkgdir

    mkdir -p $pkgdir/userdata/roms/tools
    
    ls -latr
}
